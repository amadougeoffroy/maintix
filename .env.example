# Copier en .env (local) ou renseigner dans Dokploy > Environment.

# --- Obligatoire ---
APP_URL=https://maintix.mondomaine.fr        # URL publique EXACTE (https en production : cookies Secure)
POSTGRES_PASSWORD=change-moi-long-et-aleatoire   # tout caractère accepté (ex. : openssl rand -base64 24)
BOOTSTRAP_TOKEN=change-moi-jeton-installation-aleatoire

# --- E-mail (liens de connexion, rapports, factures) ---
SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.fr:587   # vide = liens écrits dans les logs (dev uniquement)
MAIL_FROM=Maintix <no-reply@mondomaine.fr>

# --- Alertes d'astreinte : notifications push (générer : npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mondomaine.fr
ESCALATION_MINUTES=10                         # délai avant escalade vers le bureau sans prise en charge

# --- Alertes d'astreinte : SMS (au choix) ---
SMS_PROVIDER=                                 # twilio | webhook
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+33700000000
SMS_WEBHOOK_URL=                              # POST JSON {to, text}, en-tête Bearer si SMS_WEBHOOK_TOKEN
SMS_WEBHOOK_TOKEN=

# --- Supervision ---
LOG_LEVEL=info                                # debug | info | warn | error | silent
METRICS_TOKEN=                                # active /api/metrics (Prometheus) avec ce jeton Bearer
ERROR_WEBHOOK_URL=                            # Slack/Mattermost/ntfy : reçoit les erreurs 500 (1 par minute et par type)
APP_VERSION=                                  # affiché par /api/health

# --- Réseau ---
TRUST_PROXY=1                                 # 1 derrière Traefik/Dokploy
HOST_PORT=8787
