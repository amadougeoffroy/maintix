{
  "name": "maintix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:server": "cd server && npm run dev",
    "test:server": "cd server && npm test",
    "test:e2e:server": "playwright test -c playwright.server.config.ts",
    "test:all": "npm test && npm run test:server && npm run test:e2e && npm run test:e2e:server",
    "brand": "node brand/build-assets.mjs && node brand/build-charte.mjs && node brand/build-kit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.59.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide": "^1.59.0",
    "opentype.js": "^2.0.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.8",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
